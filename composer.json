{
  "name": "gaming-cafe/serverless",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.60",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "backend/app/",
      "Database\\Factories\\": "backend/database/factories/",
      "Database\\Seeders\\": "backend/database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
